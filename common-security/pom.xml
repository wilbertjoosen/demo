<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>common-security</artifactId>
    <name>common-security</name>
    <description>Shared JWT resource-server security config for all backend services</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <!-- Every service that pulls in common-security is WebMVC-based, so this is safe to put
                 here once rather than in each of the 9 services' own poms — springdoc auto-configures
                 itself (unlike ResourceServerSecurityConfig, no manual @Import needed). -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <!-- Same reasoning as springdoc above: every consuming service already has
                 spring-boot-starter-actuator on its own classpath, so this alone is enough for Boot
                 to auto-configure a Tracer/ObservationRegistry and export spans via OTLP — no
                 per-service config beyond the OTLP endpoint (set once, centrally, in config-server's
                 config-repo/application.yml). This isn't the more obvious micrometer-tracing-bridge-otel
                 + opentelemetry-exporter-otlp pairing — in Spring Boot 4.x those are just the
                 underlying libraries; the actual autoconfiguration classes that wire them together
                 live specifically in this artifact (verified against the resolved classpath —
                 neither of the two "obvious" deps alone registers any autoconfiguration). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- Both OtlpTracingAutoConfiguration AND OpenTelemetryTracingAutoConfiguration (the one
                 that actually creates the Tracer bean) are @ConditionalOnClass on OtelTracer, which
                 lives here — confirmed missing from the actually-deployed jar's BOOT-INF/lib even
                 after adding opentelemetry-exporter-otlp below (that fix alone was necessary but not
                 sufficient: zero tracing-related log lines at all, not even a Tracer being created,
                 because this half of the requirement was still missing). -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <!-- OtlpTracingAutoConfiguration (in the artifact above) is @ConditionalOnClass on
                 OtlpHttpSpanExporter/OtlpGrpcSpanExporter — neither ships transitively with
                 spring-boot-micrometer-tracing-opentelemetry itself (confirmed: absent from this
                 module's own resolved dependency:tree). Without this, the whole OTLP autoconfiguration
                 silently backs off — no Tracer, no exporter, nothing — which is exactly what was
                 happening here: every span export appeared correctly configured end to end (endpoint,
                 sampling, network path, all independently verified reachable) and Tempo still received
                 precisely zero traces. This is the actual missing piece, not a config problem. -->
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- EndUserIdTracingFilter (an OncePerRequestFilter) needs jakarta.servlet types to
                 compile — common-security has no spring-boot-starter-web dependency of its own, only
                 spring-security-web (transitively, via spring-boot-starter-security), which doesn't
                 expose the servlet API at this module's own compile time. `provided` scope: every
                 consuming service already supplies the real servlet container via its own
                 spring-boot-starter-web, so this isn't bundled into the runtime jar, just needed here
                 for common-security to compile against the types at all. Version comes from Spring
                 Boot's own dependency management (spring-boot-starter-parent), same as every other
                 dependency in this file. -->
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- common-security had no test dependencies at all before EndUserIdTracingFilter —
                 added specifically to cover it (a filter running on every authenticated request
                 across all 9 services is worth a regression test). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
