VITE_KEYCLOAK_URL=http://keycloak.localhost:8181
VITE_KEYCLOAK_REALM=demo
VITE_KEYCLOAK_CLIENT_ID=demo-spa
# Empty/relative — the k8s Ingress (k8s/ingress.yaml) routes /api and /actuator on the SAME
# origin the frontend itself is served from (demo.localhost:18090, qa.demo.localhost:18090), so
# same-origin relative paths work in every environment without a per-environment rebuild. A
# hardcoded absolute host:port here (e.g. http://localhost:8080) only works if you separately run
# the gateway locally on that port — never true for the actual deployed frontend.
# Same reasoning as VITE_API_BASE_URL above: empty means same-origin, resolved at runtime by
# resolveWsUrl() (src/lib/ws.ts) against window.location instead of a build-time host:port that
# only ever matches the machine actually running that service.
VITE_API_BASE_URL=
VITE_NOTIFICATIONS_WS_URL=
VITE_CHAT_WS_BASE_URL=
