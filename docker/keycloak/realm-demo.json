{
  "realm": "demo",
  "enabled": true,
  "displayName": "Demo",
  "loginTheme": "demo",
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular authenticated user" },
      { "name": "admin", "description": "Full administrative access — superset of every domain role below" },
      { "name": "finance", "description": "Payment/refund administration: gateway availability toggles, payment record deletion" },
      { "name": "product_manager", "description": "Product catalog administration: create/update/delete products, batch import" },
      { "name": "shipping_manager", "description": "Shipment administration: carrier/tracking record deletion" },
      { "name": "inventory_manager", "description": "Inventory administration: stock adjustments, warehouse reservations" },
      { "name": "warehouse", "description": "Warehouse floor role: confirm-picked/report-issue on PENDING_WAREHOUSE shipments" },
      { "name": "delivery_agent", "description": "Delivery-agent role: confirm-delivered/report-issue on PENDING_DELIVERY_AGENT deliveries" }
    ]
  },
  "clients": [
    {
      "clientId": "demo-spa",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://demo.localhost:18090/*"],
      "webOrigins": ["http://localhost:5173", "http://demo.localhost:18090"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "order-service-client",
      "enabled": true,
      "publicClient": false,
      "secret": "order-service-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Machine-to-machine client_credentials client — order-service uses this to call inventory-service"
    },
    {
      "clientId": "user-service-admin-client",
      "enabled": true,
      "publicClient": false,
      "secret": "user-service-admin-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Machine-to-machine client_credentials client — user-service uses this to read (and admin-create) usernames/emails/names via Keycloak's own Admin REST API instead of duplicating them in Mongo"
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["offline_access", "uma_authorization", "user"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["offline_access", "uma_authorization", "user", "admin"],
      "clientRoles": {
        "realm-management": ["impersonation"]
      }
    },
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@example.com",
      "emailVerified": true,
      "firstName": "Ops",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access", "uma_authorization", "user", "finance", "product_manager",
        "shipping_manager", "inventory_manager", "warehouse", "delivery_agent"
      ]
    },
    {
      "username": "service-account-user-service-admin-client",
      "enabled": true,
      "serviceAccountClientId": "user-service-admin-client",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users", "query-users", "view-realm"]
      }
    }
  ]
}
